rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function isAdmin() {
      return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Comptes administrateurs : créés à la main dans la console (jamais depuis l'app)
    match /admins/{uid} {
      allow read: if signed() && request.auth.uid == uid;
      allow write: if false;
    }

    // Données PUBLIQUES d'une UE (portail : intitulé, enseignant, heures, salle…)
    match /ues/{code} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        // l'enseignant de l'UE peut modifier sa matière mais pas se réattribuer l'UE
        || (signed() && resource.data.get('teacherUid', '') == request.auth.uid
            && request.resource.data.teacherUid == request.auth.uid)
        // prise en charge : seulement si l'admin a attribué cet email à l'UE
        || (signed() && resource.data.get('teacherUid', '') == ''
            && request.resource.data.teacherUid == request.auth.uid
            && exists(/databases/$(database)/documents/ue_assignments/$(code))
            && get(/databases/$(database)/documents/ue_assignments/$(code)).data.email == request.auth.token.email.lower()
            // l'email doit avoir été vérifié (empêche de prendre l'email d'un autre)
            && request.auth.token.email_verified == true);
    }

    // Attributions UE -> email (gérées par l'admin, invisibles pour les autres)
    match /ue_assignments/{code} {
      allow read, write: if isAdmin();
    }

    // Données PRIVÉES : notes, appel, historique → enseignant de l'UE ou admin
    match /ues_private/{code} {
      allow read, write: if isAdmin()
        || (signed() && get(/databases/$(database)/documents/ues/$(code)).data.get('teacherUid', '') == request.auth.uid);
    }

    // Listes d'étudiants (noms + matricules)
    match /system/class_lists {
      allow read: if signed();
      allow write: if isAdmin();
    }

    // Notifications : tout compte connecté peut en créer, seul l'admin les lit/supprime
    match /admin_notifications/{id} {
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['title', 'message', 'type', 'by', 'timestamp'])
        && request.resource.data.title is string && request.resource.data.title.size() < 150
        && request.resource.data.message is string && request.resource.data.message.size() < 400
        && request.resource.data.type in ['info', 'login', 'presence', 'absence', 'important', 'urgent']
        && request.resource.data.get('by', '') == request.auth.token.email
        && request.resource.data.timestamp == request.time;
      allow read, delete: if isAdmin();
    }
  }
}
